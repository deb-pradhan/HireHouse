# Copy to .env.local for local development. Do not commit .env.local.

# PROOF gate (guardrail #1 — no fabricated facts).
#   ship  = default. Only numbers marked real:true render; placeholders fall back
#           to proof-by-construction copy. This is what production must use.
#   draft = show placeholder figures locally while designing. NEVER ship.
NEXT_PUBLIC_PROOF_MODE=ship

# Blog CMS (Payload, hosted separately on Railway — see docs/07-BLOG-CMS.md).
# Unset = the blog serves local fixtures. Set = it reads the live Payload API.
# PAYLOAD_API_URL=https://your-cms.up.railway.app
# PAYLOAD_API_TOKEN=            # optional, for draft/private reads
